# v3-info template environment variables (CRA requires REACT_APP_* prefix)

# Which environment configuration to use from the chain registry:
# - staging (default)
# - production
REACT_APP_DEPLOY_ENV=staging

# Optional: link used by header "Swap" / "Back to swap page"
REACT_APP_INTERFACE_URL=https://example.io

# Optional per-chain overrides (computed from chain `key` + env):
# REACT_APP_CHAIN_<CHAIN_KEY>_<VAR>_<ENV>
#
# <CHAIN_KEY> is the registry `key`, uppercased, with `-` replaced by `_`
# <ENV> is STAGING or PRODUCTION
#
# Supported <VAR>:
# - ENABLED (true|false)              (not environment-specific)
# - TOKEN_LIST_URL                    (environment-specific)
# - DATA_SUBGRAPH_URL                 (environment-specific)
# - BLOCK_SUBGRAPH_URL                (environment-specific)

# Example overrides for the default chain key "ethereum"
REACT_APP_CHAIN_ETHEREUM_ENABLED=true
REACT_APP_CHAIN_ETHEREUM_TOKEN_LIST_URL_STAGING=https://example.io/tokenlist.json
REACT_APP_CHAIN_ETHEREUM_TOKEN_LIST_URL_PRODUCTION=https://example.io/tokenlist.json
REACT_APP_CHAIN_ETHEREUM_DATA_SUBGRAPH_URL_STAGING=
REACT_APP_CHAIN_ETHEREUM_BLOCK_SUBGRAPH_URL_STAGING=
REACT_APP_CHAIN_ETHEREUM_DATA_SUBGRAPH_URL_PRODUCTION=
REACT_APP_CHAIN_ETHEREUM_BLOCK_SUBGRAPH_URL_PRODUCTION=

